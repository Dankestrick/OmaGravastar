class HelperError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


# ---- Finding the dongle ------------------------------------------------------

def usage_pages(descriptor):
    """Return the usage pages declared in a HID report descriptor."""
    pages, i = set(), 0
    while i < len(descriptor):
        prefix = descriptor[i]
        if prefix == 0xFE:  # long item
            i += 3 + (descriptor[i + 1] if i + 1 < len(descriptor) else 0)
            continue
        size = (0, 1, 2, 4)[prefix & 0x03]
        if prefix & 0xFC == 0x04:
            pages.add(int.from_bytes(descriptor[i + 1:i + 1 + size], "little"))
        i += 1 + size
    return pages


def find_device():
    base = "/sys/class/hidraw"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        names = []
    for name in names:
        dev = os.path.join(base, name, "device")
        try:
            with open(os.path.join(dev, "uevent")) as f:
                hid_id = next((l.split("=", 1)[1].strip() for l in f if l.startswith("HID_ID=")), "")
            with open(os.path.join(dev, "report_descriptor"), "rb") as f:
                descriptor = f.read()
        except OSError:
            continue
        parts = hid_id.split(":")
        if len(parts) != 3:
            continue
        vendor, product = int(parts[1], 16), int(parts[2], 16)
        if vendor == VENDOR_ID and product in PRODUCT_IDS and SETTINGS_USAGE_PAGE in usage_pages(descriptor):
            return "/dev/" + name
    raise HelperError(2, "Gravastar dongle not found")


# ---- Talking to it -----------------------------------------------------------

def packet(command, address=0, data=b"", length=None):
    if len(data) > MAX_CHUNK:
        raise ValueError("a packet carries at most 10 data bytes")
    body = bytearray(PACKET_LEN)
    body[0] = command
    body[2] = (address >> 8) & 0xFF
    body[3] = address & 0xFF
    body[4] = len(data) if length is None else length
    body[5:5 + len(data)] = data
    body[15] = (0x55 - (REPORT_ID + sum(body[:15]))) & 0xFF
    return bytes([REPORT_ID]) + bytes(body)


def valid_reply(data):
    return (len(data) >= PACKET_LEN + 1 and data[0] == REPORT_ID
            and (REPORT_ID + sum(data[1:PACKET_LEN + 1])) & 0xFF == 0x55)


class Mouse:
    def __init__(self, path):
        self.path = path
        try:
            self.fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError:
            raise HelperError(2, f"No permission to open {path}. Install the udev rule from the README.")

    def close(self):
        os.close(self.fd)

    def drain(self):
        while select.select([self.fd], [], [], 0)[0]:
            try:
                os.read(self.fd, 64)
            except BlockingIOError:
                break

    def transact(self, command, address=None, data=b"", length=None):
        """Send one request and return the 16-byte reply, or None."""
        raw = packet(command, address or 0, data, length)
        for _ in range(RETRIES):
            self.drain()
            os.write(self.fd, raw)
            deadline = time.monotonic() + REPLY_TIMEOUT
            while True:
                left = deadline - time.monotonic()
                if left <= 0 or not select.select([self.fd], [], [], left)[0]:
                    break
                try:
                    reply = os.read(self.fd, 64)
                except BlockingIOError:
                    continue
                if not valid_reply(reply) or reply[1] != command:
                    continue  # another program's reply, or noise
                body = reply[1:PACKET_LEN + 1]
                if address is not None and (body[2] << 8 | body[3]) != address:
                    continue
                return body
            time.sleep(0.2)
        return None

    def awake(self):
        reply = self.transact(CMD_ONLINE)
        return reply is not None and reply[5] == 1

    def require_awake(self):
        if not self.awake():
            raise HelperError(3, "Mouse is asleep. Move it and try again.")

    def read(self, address, length):
        out = bytearray()
        while length > 0:
            n = min(length, MAX_CHUNK)
            reply = self.transact(CMD_READ, address, length=n)
            if reply is None or reply[1] != 0 or reply[4] != n:
                raise HelperError(3, f"No answer reading 0x{address:02x}. Move the mouse and try again.")
            out += reply[5:5 + n]
            address += n
            length -= n
        return bytes(out)

    def write(self, address, data):
        data = bytes(data)
        # The mouse takes at most 10 bytes per write packet.
        for offset in range(0, len(data), MAX_CHUNK):
            piece = data[offset:offset + MAX_CHUNK]
            reply = self.transact(CMD_WRITE, address + offset, piece)
            if reply is None or reply[1] != 0:
                raise HelperError(4, f"The mouse did not accept the write at 0x{address + offset:02x}")
        if self.read(address, len(data)) != data:
            raise HelperError(4, f"The mouse did not keep the value written at 0x{address:02x}")

    def write_scalar(self, address, value):
        self.write(address, [value & 0xFF, (0x55 - value) & 0xFF])


# ---- Decoding ----------------------------------------------------------------

def scalar(block, address):
    if address + 1 >= len(block):
        return None
    value, check = block[address], block[address + 1]
    return value if (value + check) & 0xFF == 0x55 else None


def decode_dpi(entry):
    low, dup, flags, check = entry
    if low != dup or (low + dup + flags + check) & 0xFF != 0x55:
        return None
    return ((((flags >> 2) & 0x03) << 8) + low + 1) * 50


def encode_dpi(dpi):
    code = dpi // 50 - 1
    low, high = code & 0xFF, (code >> 8) & 0x03
    flags = (high << 2) | (high << 6)
    return [low, low, flags, (0x55 - low - low - flags) & 0xFF]


def on_off(value):
    return None if value is None else value != 0


def read_macro(mouse, slot):
    base = ADDR_MACROS + slot * MACRO_LEN
    head = mouse.read(base, 32)
    length, count = head[0], head[31]
    if not 0 < length <= MACRO_NAME_MAX or count > MACRO_MAX_EVENTS:
        return None
    body = mouse.read(base + 32, count * 5) if count else b""
    events = []
    for i in range(count):
        flags, low, high, dhigh, dlow = body[i * 5:i * 5 + 5]
        events.append({"down": flags >> 6 == 2, "type": flags & 0x0F,
                       "code": high << 8 | low, "delay": dhigh << 8 | dlow})
    return {"name": bytes(head[1:1 + length]).decode("utf-8", "replace"), "events": events}


def encode_macro(macro):
    name = str(macro.get("name", "")).encode("utf-8")[:MACRO_NAME_MAX]
    events = macro.get("events", [])
    if not name:
        raise HelperError(1, "Please enter the macro name.")
    if not events:
        raise HelperError(1, "The macro has no events.")
    if len(events) > MACRO_MAX_EVENTS:
        raise HelperError(1, "The number of macro keys has reached the upper limit.")
    data = bytearray(b"\xff" * 32)
    data[0] = len(name)
    data[1:1 + len(name)] = name
    data[31] = len(events)
    body = bytearray()
    for event in events:
        kind, code, delay = int(event["type"]), int(event["code"]), int(event.get("delay", 0))
        if kind not in (1, 4) or not 0 <= code <= 0xFFFF or not 0 <= delay <= 0xFFFF:
            raise HelperError(1, f"Bad macro event: {event}")
        body += bytes([((2 if event.get("down") else 1) << 6) | kind, code & 0xFF, code >> 8,
                       delay >> 8, delay & 0xFF])
    # Checksum as the web driver writes it: 0x55 - sum(events) - count.
    body.append(((0x55 - sum(body)) - len(events)) & 0xFF)
    return bytes(data + body)


def decode_buttons(block, shortcuts, mouse=None):
    buttons = []
    for number in range(1, 7):
        slot = BUTTON_SLOTS[number]
        group, high, low, check = block[ADDR_BUTTONS + slot * 4:ADDR_BUTTONS + slot * 4 + 4]
        code = high << 8 | low
        label = None
        if (group + high + low + check) & 0xFF == 0x55:
            label = PLAIN_NAMES.get((group, code))
            if group == GROUP_MULTIMEDIA and shortcuts:
                record = shortcuts[slot * SHORTCUT_LEN:slot * SHORTCUT_LEN + 8]
                if record[0] == 2 and record[1] == 0x82:
                    label = MEDIA_NAMES.get(record[2] | record[3] << 8)
                label = label or "Combo key"
            elif group == GROUP_MACRO:
                macro = read_macro(mouse, slot) if mouse else None
                label = "Macro"
                buttons.append({"button": number, "action": label, "group": group, "code": code,
                                "macro": macro, "method": low})
                continue
            elif label is None:
                label = OTHER_GROUPS.get(group, "Unknown")
        buttons.append({"button": number, "action": label or "Unknown", "group": group, "code": code})
    return buttons


def read_settings(mouse):
    block = mouse.read(0, 0xBD)
    stage_count = scalar(block, ADDR_STAGE_COUNT) or 1
    stage_count = max(1, min(stage_count, 8))
    active = scalar(block, ADDR_ACTIVE_STAGE)
    stages = [decode_dpi(block[ADDR_DPI_STAGES + i * 4:ADDR_DPI_STAGES + i * 4 + 4])
              for i in range(stage_count)]
    colors = []
    for i in range(stage_count):
        r, g, b, check = block[ADDR_DPI_COLORS + i * 4:ADDR_DPI_COLORS + i * 4 + 4]
        colors.append("#{:02x}{:02x}{:02x}".format(r, g, b) if (r + g + b + check) & 0xFF == 0x55 else None)
    light = block[ADDR_LIGHTING:ADDR_LIGHTING + LIGHTING_LEN]
    light_ok = sum(light) & 0xFF == 0x55
    lights_on = scalar(block, ADDR_LIGHTS_ON)
    effect = light[0] if light_ok else None
    lod = scalar(block, ADDR_LOD)
    sleep = scalar(block, ADDR_SLEEP)
    return {
        "pollingHz": POLLING_HZ.get(scalar(block, ADDR_POLLING)),
        "dpiStages": stages,
        "dpiColors": colors,
        "activeStage": None if active is None else active + 1,
        "dpi": stages[active] if active is not None and active < len(stages) else None,
        "lod": LOD_NAMES.get(lod),
        "lodRaw": lod,
        "keyResponseMs": scalar(block, ADDR_DEBOUNCE),
        "motionSync": on_off(scalar(block, ADDR_MOTION_SYNC)),
        "angleSnap": on_off(scalar(block, ADDR_ANGLE_SNAP)),
        "ripple": on_off(scalar(block, ADDR_RIPPLE)),
        "performance": on_off(scalar(block, ADDR_PERFORMANCE)),
        "performanceTimer": SLEEP_NAMES.get(scalar(block, ADDR_PERFORMANCE_TIMER)),
        "sensorMode": SENSOR_MODE_NAMES.get(scalar(block, ADDR_SENSOR_MODE)),
        "sleep": SLEEP_NAMES.get(sleep),
        "sleepRaw": sleep,
        "buttons": decode_buttons(block, mouse.read(ADDR_SHORTCUTS, 6 * SHORTCUT_LEN), mouse),
        "lighting": {
            "on": on_off(lights_on),
            "effect": "Off" if lights_on == 0 else EFFECT_NAMES.get(effect),
            "lastEffect": EFFECT_NAMES.get(effect),
            "color": "#{:02x}{:02x}{:02x}".format(*light[1:4]) if light_ok else None,
            "speed": light[4] + 1 if light_ok else None,
            "brightness": light[5] + 1 if light_ok else None,
            "offWhenMoving": on_off(scalar(block, ADDR_OFF_WHEN_MOVING)),
        },
    }


CACHED_KEYS = ("battery", "charging", "batteryMv", "firmware", "receiverFirmware", "profile", "settings")


def cache_path():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "omagravastar", "last-status.json")


def save_cache(status):
    path = cache_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w") as f:
            json.dump({k: status[k] for k in CACHED_KEYS if k in status}, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def load_cache():
    try:
        with open(cache_path()) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def read_status(mouse):
    status = {"connected": True, "device": mouse.path, "awake": mouse.awake()}
    if not status["awake"]:
        # Asleep: answer with the last values read while it was awake.
        cached = load_cache()
        if cached:
            status.update({k: cached[k] for k in CACHED_KEYS if k in cached})
            status["stale"] = True
        return status
    battery = mouse.transact(CMD_BATTERY)
    if battery is not None and battery[1] == 0 and battery[5] <= 100:
        status["battery"] = battery[5]
        status["charging"] = battery[6] == 1
        millivolts = battery[7] << 8 | battery[8]
        status["batteryMv"] = millivolts or None
    firmware = mouse.transact(CMD_FIRMWARE)
    if firmware is not None and firmware[1] == 0:
        status["firmware"] = f"v{firmware[5]}.{firmware[6]:02x}"
    dongle = mouse.transact(CMD_DONGLE_FIRMWARE)
    if dongle is not None:
        # The web driver shows v1.0 for a reply of 01 in the status byte.
        status["receiverFirmware"] = f"v{dongle[1]}.{dongle[2]}"
    profile = mouse.transact(CMD_PROFILE)
    if profile is not None and profile[1] == 0:
        status["profile"] = profile[5] + 1
    settings = read_settings(mouse)
    settings["longDistance"] = read_long_distance(mouse)
    status["settings"] = settings
    save_cache(status)
    return status


def read_long_distance(mouse):
    reply = mouse.transact(CMD_GET_LONG_DISTANCE)
    if reply is None or reply[1] != 0:
        return None
    return reply[5] == 1


def set_long_distance(mouse, value):
    data = bytes([value]) + bytes(MAX_CHUNK - 1)
    reply = mouse.transact(CMD_SET_LONG_DISTANCE, data=data)
    if reply is None or reply[1] != 0:
        raise HelperError(4, "The mouse did not accept the long distance mode change")
    if read_long_distance(mouse) != bool(value):
        raise HelperError(4, "The mouse did not keep the long distance mode change")


# ---- Commands ----------------------------------------------------------------

def parse_int(text, low, high, label):
    try:
        value = int(text)
    except ValueError:
        raise HelperError(1, f"{label} must be a whole number")
    if not low <= value <= high:
        raise HelperError(1, f"{label} must be {low}-{high}")
    return value


def parse_switch(text):
    if text not in ("on", "off"):
        raise HelperError(1, "use on or off")
    return 1 if text == "on" else 0


def update_lighting(mouse, change):
    record = bytearray(mouse.read(ADDR_LIGHTING, LIGHTING_LEN))
    if sum(record) & 0xFF != 0x55:
        raise HelperError(4, "The lighting settings on the mouse look damaged; not writing")
    change(record)
    record[6] = (0x55 - sum(record[:6])) & 0xFF
    mouse.write(ADDR_LIGHTING, record)


def run_set(mouse, args):
    if len(args) < 2:
        raise HelperError(1, "set needs a setting and a value")
    what, rest = args[0], args[1:]
    if what == "dpi-stage":
        if len(rest) != 2:
            raise HelperError(1, "usage: set dpi-stage <stage> <dpi>")
        count = scalar(mouse.read(ADDR_STAGE_COUNT, 2), 0) or 1
        stage = parse_int(rest[0], 1, count, "stage")
        dpi = parse_int(rest[1], 50, 26000, "DPI")
        if dpi % 50:
            raise HelperError(1, "DPI must be a multiple of 50")
        mouse.write(ADDR_DPI_STAGES + (stage - 1) * 4, encode_dpi(dpi))
    elif what == "stage-count":
        count = parse_int(rest[0], 1, 8, "stage count")
        active = scalar(mouse.read(ADDR_ACTIVE_STAGE, 2), 0) or 0
        if active > count - 1:
            mouse.write_scalar(ADDR_ACTIVE_STAGE, count - 1)
        mouse.write_scalar(ADDR_STAGE_COUNT, count)
    elif what == "active-stage":
        count = scalar(mouse.read(ADDR_STAGE_COUNT, 2), 0) or 1
        mouse.write_scalar(ADDR_ACTIVE_STAGE, parse_int(rest[0], 1, count, "stage") - 1)
    elif what == "polling":
        hz = parse_int(rest[0], 125, 8000, "polling rate")
        if hz not in POLLING_RAW:
            raise HelperError(1, "polling rate must be 125, 250, 500, 1000, 2000, 4000 or 8000")
        mouse.write_scalar(ADDR_POLLING, POLLING_RAW[hz])
    elif what == "key-response":
        mouse.write_scalar(ADDR_DEBOUNCE, parse_int(rest[0], 0, 15, "key response time"))
    elif what in SWITCHES:
        mouse.write_scalar(SWITCHES[what], parse_switch(rest[0]))
    elif what == "lod":
        if rest[0] not in LOD_CHOICES:
            raise HelperError(1, "lod must be " + ", ".join(LOD_CHOICES))
        mouse.write_scalar(ADDR_LOD, LOD_CHOICES[rest[0]])
    elif what in ("sleep", "performance-timer"):
        if rest[0] not in SLEEP_CHOICES:
            raise HelperError(1, f"{what} must be " + ", ".join(SLEEP_CHOICES))
        address = ADDR_SLEEP if what == "sleep" else ADDR_PERFORMANCE_TIMER
        mouse.write_scalar(address, SLEEP_CHOICES[rest[0]])
    elif what == "profile":
        profile = parse_int(rest[0], 1, PROFILE_COUNT, "profile")
        # Length 1: the mouse rejects a padded packet here.
        reply = mouse.transact(CMD_SET_PROFILE, data=bytes([profile - 1]))
        if reply is None or reply[1] != 0:
            raise HelperError(4, "The mouse did not switch profiles")
        time.sleep(0.3)
        now = mouse.transact(CMD_PROFILE)
        if now is None or now[5] != profile - 1:
            raise HelperError(4, "The mouse did not keep the new profile")
    elif what == "sensor-mode":
        if rest[0] not in SENSOR_MODES:
            raise HelperError(1, "sensor-mode must be lp or hp (Corded is automatic above 1000 Hz)")
        mouse.write_scalar(ADDR_SENSOR_MODE, SENSOR_MODES[rest[0]])
    elif what == "long-distance":
        set_long_distance(mouse, parse_switch(rest[0]))
    else:
        raise HelperError(1, f"unknown setting: {what}")


def run_button(mouse, args):
    if len(args) != 2:
        raise HelperError(1, 'usage: button <1-6> "<action>"')
    number = parse_int(args[0], 1, 6, "button")
    action = args[1]
    if action not in ACTIONS:
        raise HelperError(1, f"unknown action: {action}. Run `omagravastarctl actions` for the list")
    _, group, code = ACTIONS[action]
    slot = BUTTON_SLOTS[number]
    # Same rule as the web driver: some button must stay Left Click.
    if action != "Left Click":
        block = mouse.read(ADDR_BUTTONS, 6 * 4)
        others = [BUTTON_SLOTS[n] for n in range(1, 7) if n != number]
        if not any(block[s * 4] == 1 and (block[s * 4 + 1] << 8 | block[s * 4 + 2]) == 0x0100 for s in others):
            raise HelperError(1, "Must keep left key. Another button has to be Left Click first.")
    if group == GROUP_MULTIMEDIA:
        record = [2, 0x82, code & 0xFF, code >> 8, 0x42, code & 0xFF, code >> 8, 0]
        record[7] = (0x55 - sum(record[:7])) & 0xFF
        mouse.write(ADDR_SHORTCUTS + slot * SHORTCUT_LEN, record)
        code = 0
    entry = [group, code >> 8, code & 0xFF, 0]
    entry[3] = (0x55 - sum(entry[:3])) & 0xFF
    mouse.write(ADDR_BUTTONS + slot * 4, entry)


# ---- Export / import (same .bin format as Gravastar's web driver) ------------
# The file is the web driver's 16 KB copy of the mouse's memory for one
# profile, with 0xff wherever it did not read, then a 64-byte tag:
# "Compx Inc" at +0, device type at +32, sensor type at +48.
FLASH_SIZE = 16384
TAG_LEN = 64
DEVICE_TYPE = "mouse"
SENSOR_TYPE = "3395"
MAX_DPI_STAGES = 8
ADDR_MACROS = 0x300
MACRO_LEN = 384
ADDR_SENSOR_EXTRA = 0x1B00    # Sensor3955DPI .. EndEeprom in the web driver
SENSOR_EXTRA_END = 0x1B55
REGIONS = [
    (0x000, 0x100),                                   # settings block
    (ADDR_SHORTCUTS, ADDR_SHORTCUTS + 6 * SHORTCUT_LEN),  # multimedia / combo records
    (ADDR_MACROS, ADDR_MACROS + 6 * MACRO_LEN),       # macros
    (ADDR_SENSOR_EXTRA, SENSOR_EXTRA_END),
]


def backup_dir():
    return os.path.join(os.path.dirname(cache_path()), "backups")


def read_image(mouse):
    image = bytearray(b"\xff" * FLASH_SIZE)
    for start, end in REGIONS:
        image[start:end] = mouse.read(start, end - start)
    return image


def tagged(image):
    tag = bytearray(TAG_LEN)
    for offset, text in ((0, "Compx Inc"), (32, DEVICE_TYPE), (48, SENSOR_TYPE)):
        tag[offset:offset + len(text)] = text.encode()
    return bytes(image) + bytes(tag)


def write_file(path, data):
    path = os.path.abspath(os.path.expanduser(path))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "wb") as f:
        f.write(data)
    os.replace(path + ".tmp", path)
    return path


def run_export(mouse, args):
    if len(args) != 1:
        raise HelperError(1, "usage: export <file.bin>")
    return write_file(args[0], tagged(read_image(mouse)))


def parse_import(data):
    if len(data) <= TAG_LEN:
        raise HelperError(1, "That file is too small to be a mouse profile.")
    tag = data[-TAG_LEN:]
    text = lambda a, b: tag[a:b].rstrip(b"\0").decode("utf-8", "replace")
    if text(0, 32) != "Compx Inc":
        raise HelperError(1, "The imported configuration is incorrect.")
    if text(32, 48) != DEVICE_TYPE or text(48, 64) != SENSOR_TYPE:
        raise HelperError(1, "The imported configuration does not match this device.")
    image = bytearray(data[:-TAG_LEN])
    if len(image) < FLASH_SIZE:
        image += b"\xff" * (FLASH_SIZE - len(image))
    # Same clamps as the web driver: polling and DPI stages within range.
    if image[0] not in POLLING_HZ:
        image[0] = POLLING_RAW[8000]
    image[1] = (0x55 - image[0]) & 0xFF
    if not 1 <= image[2] <= MAX_DPI_STAGES:
        image[2] = min(max(image[2], 1), MAX_DPI_STAGES)
    image[3] = (0x55 - image[2]) & 0xFF
    if image[4] > image[2] - 1:
        image[4] = image[2] - 1
    image[5] = (0x55 - image[4]) & 0xFF
    return image


def run_import(mouse, args):
    if len(args) != 1:
        raise HelperError(1, "usage: import <file.bin>")
    try:
        with open(os.path.expanduser(args[0]), "rb") as f:
            data = f.read()
    except OSError as error:
        raise HelperError(1, f"Could not read {args[0]}: {error.strerror}")
    image = parse_import(data)
    current = read_image(mouse)
    profile = mouse.transact(CMD_PROFILE)
    number = profile[5] + 1 if profile is not None and profile[1] == 0 else 0
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = write_file(os.path.join(backup_dir(), f"profile-{number}-before-import-{stamp}.bin"), tagged(current))
    written = 0
    for start, end in REGIONS:
        if start == 0:
            # Only up to the last byte the file actually uses, like the web driver.
            used = [i for i in range(0x100) if image[i] != 0xFF]
            end = (used[-1] + 1) if used else 0
        for chunk in range(start, end, MAX_CHUNK):
            stop = min(chunk + MAX_CHUNK, end)
            if image[chunk:stop] != current[chunk:stop]:
                mouse.write(chunk, image[chunk:stop])
                written += 1
    return {"backup": backup, "chunksWritten": written}


def run_macro(mouse, args):
    if len(args) != 2:
        raise HelperError(1, "usage: macro <1-6> <macro.json>")
    number = parse_int(args[0], 1, 6, "button")
    try:
        if args[1].lstrip().startswith("{"):
            macro = json.loads(args[1])        # the plugin passes the macro inline
        else:
            with open(os.path.expanduser(args[1])) as f:
                macro = json.load(f)
    except (OSError, ValueError) as error:
        raise HelperError(1, f"Could not read the macro: {error}")
    method = int(macro.get("method", 1))
    if method not in MACRO_METHODS:
        raise HelperError(1, "method must be 1-252 (times), 253, 254 or 255")
    slot = BUTTON_SLOTS[number]
    block = mouse.read(ADDR_BUTTONS, 6 * 4)
    others = [BUTTON_SLOTS[n] for n in range(1, 7) if n != number]
    if not any(block[s * 4] == 1 and (block[s * 4 + 1] << 8 | block[s * 4 + 2]) == 0x0100 for s in others):
        raise HelperError(1, "Must keep left key. Another button has to be Left Click first.")
    mouse.write(ADDR_MACROS + slot * MACRO_LEN, encode_macro(macro))
    entry = [GROUP_MACRO, slot, method, 0]
    entry[3] = (0x55 - sum(entry[:3])) & 0xFF
    mouse.write(ADDR_BUTTONS + slot * 4, entry)


def run_light(mouse, args):
    if len(args) != 2:
        raise HelperError(1, "light needs a setting and a value")
    what, value = args
    if what == "effect":
        if value == "off":
            mouse.write_scalar(ADDR_LIGHTS_ON, 0)
            return
        if value not in EFFECTS:
            raise HelperError(1, "effect must be off, " + ", ".join(EFFECTS))
        def set_effect(record):
            record[0] = EFFECTS[value]
        update_lighting(mouse, set_effect)
        mouse.write_scalar(ADDR_LIGHTS_ON, 1)
    elif what == "color":
        text = value.lstrip("#")
        try:
            rgb = bytes.fromhex(text)
        except ValueError:
            rgb = b""
        if len(rgb) != 3:
            raise HelperError(1, "color must look like #ff00ff")
        def set_color(record):
            record[1:4] = rgb
        update_lighting(mouse, set_color)
    elif what in ("brightness", "speed"):
        level = parse_int(value, 1, 10, what)
        index = 5 if what == "brightness" else 4
        def set_level(record):
            record[index] = level - 1
        update_lighting(mouse, set_level)
    elif what == "off-when-moving":
        mouse.write_scalar(ADDR_OFF_WHEN_MOVING, parse_switch(value))
    else:
        raise HelperError(1, f"unknown light setting: {what}")


def with_lock():
    """Keep the bar's polling and a settings change from talking over each other."""
    folder = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "omagravastar")
    os.makedirs(folder, exist_ok=True)
    handle = open(os.path.join(folder, "device.lock"), "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "actions":
        groups = {}
        for label, (group_name, _, _) in ACTIONS.items():
            groups.setdefault(group_name, []).append(label)
        print(json.dumps(groups))
        return 0
    lock = with_lock()
    try:
        try:
            path = find_device()
        except HelperError as error:
            if argv[0] == "status":
                print(json.dumps({"connected": False, "awake": False, "error": str(error)}))
            raise
        mouse = Mouse(path)
        try:
            if argv[0] == "status":
                result = read_status(mouse)
            elif argv[0] in ("export", "import"):
                mouse.require_awake()
                if argv[0] == "export":
                    saved = run_export(mouse, argv[1:])
                    result = read_status(mouse)
                    result.update({"ok": True, "file": saved})
                else:
                    info = run_import(mouse, argv[1:])
                    result = read_status(mouse)
                    result.update({"ok": True}, **info)
            elif argv[0] in ("set", "light", "button", "macro"):
                mouse.require_awake()
                {"set": run_set, "light": run_light, "button": run_button, "macro": run_macro}[argv[0]](mouse, argv[1:])
                result = read_status(mouse)
                result["ok"] = True
            else:
                raise HelperError(1, f"unknown command: {argv[0]}")
        finally:
            mouse.close()
        print(json.dumps(result))
        return 0
    finally:
        lock.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except HelperError as error:
        if not (error.code == 2 and sys.argv[1:2] == ["status"]):
            print(json.dumps({"ok": False, "error": str(error)}))
        sys.exit(error.code)
