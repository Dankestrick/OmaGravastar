#!/usr/bin/env python3
"""Talk to a Gravastar Mercury X Pro through its 2.4G dongle.

The plugin calls this helper and reads its JSON output. It uses the CompX
settings channel (usage page 0xff02, report ID 8, 16-byte reports) through
/dev/hidraw, so it needs no extra packages and no root once the udev rule
from the README is installed.

Usage:
  omagravastarctl status
  omagravastarctl set dpi-stage <stage 1-8> <dpi>
  omagravastarctl set active-stage <stage 1-8>
  omagravastarctl set stage-count <1-8>
  omagravastarctl set polling <125|250|500|1000|2000|4000|8000>
  omagravastarctl set key-response <ms 0-30>
  omagravastarctl set lod <0.7mm|1mm|2mm>
  omagravastarctl set motion-sync|angle-snap|ripple|performance <on|off>
  omagravastarctl set sleep <10sec|30sec|1min|2min|3min|5min|10min|15min>
  omagravastarctl set performance-timer <10sec|30sec|1min|2min|3min|5min|10min|15min>
  omagravastarctl set long-distance <on|off>
  omagravastarctl set sensor-mode <lp|hp>   (Corded is automatic above 1000 Hz)
  omagravastarctl light effect <off|rainbow|single-color-breath|fixed-color|neon|rainbow-breath|fixed-rainbow>
  omagravastarctl light color <#rrggbb>
  omagravastarctl light brightness <1-10>
  omagravastarctl light speed <1-10>
  omagravastarctl light off-when-moving <on|off>

Every command prints one JSON object. Exit status: 0 ok, 1 bad arguments,
2 dongle not found, 3 mouse asleep, 4 the mouse rejected or lost a write.
"""

import fcntl
import json
import os
import select
import sys
import time

VENDOR_ID = 0x3554
PRODUCT_IDS = {0xF54B}
REPORT_ID = 0x08
SETTINGS_USAGE_PAGE = 0xFF02
PACKET_LEN = 16
MAX_CHUNK = 10
REPLY_TIMEOUT = 0.7
RETRIES = 4

CMD_ONLINE = 0x03
CMD_BATTERY = 0x04
CMD_WRITE = 0x07
CMD_READ = 0x08
CMD_PROFILE = 0x0E
CMD_FIRMWARE = 0x12
CMD_SET_LONG_DISTANCE = 0x16
CMD_GET_LONG_DISTANCE = 0x17
CMD_DONGLE_FIRMWARE = 0x1D

ADDR_POLLING = 0x00
ADDR_STAGE_COUNT = 0x02
ADDR_ACTIVE_STAGE = 0x04
ADDR_LOD = 0x0A
ADDR_DPI_STAGES = 0x0C
ADDR_DPI_COLORS = 0x2C
ADDR_LIGHTING = 0xA0
LIGHTING_LEN = 7
ADDR_LIGHTS_ON = 0xA7
ADDR_DEBOUNCE = 0xA9
ADDR_MOTION_SYNC = 0xAB
ADDR_SLEEP = 0xAD
ADDR_ANGLE_SNAP = 0xAF
ADDR_RIPPLE = 0xB1
ADDR_OFF_WHEN_MOVING = 0xB3
ADDR_PERFORMANCE = 0xB5
ADDR_PERFORMANCE_TIMER = 0xB7
ADDR_SENSOR_MODE = 0xB9

POLLING_RAW = {125: 8, 250: 4, 500: 2, 1000: 1, 2000: 16, 4000: 32, 8000: 64}
POLLING_HZ = {raw: hz for hz, raw in POLLING_RAW.items()}
# Lift-off distance choices from the web driver, checked on this mouse.
LOD_CHOICES = {"0.7mm": 3, "1mm": 1, "2mm": 2}
LOD_NAMES = {raw: name for name, raw in LOD_CHOICES.items()}
# Sleep time and the Highest performance timer are stored in 10-second steps.
# These are the web driver's choices for both.
SLEEP_CHOICES = {"10sec": 1, "30sec": 3, "1min": 6, "2min": 12, "3min": 18,
                 "5min": 30, "10min": 60, "15min": 90}
SLEEP_NAMES = {raw: name for name, raw in SLEEP_CHOICES.items()}
# Select mode. The mouse switches itself to Corded (ultra-performance) when
# wired or above 1000 Hz, so only LP and HP can be chosen.
SENSOR_MODES = {"lp": 0, "hp": 1}
SENSOR_MODE_NAMES = {0: "LP", 1: "HP"}

EFFECTS = {
    "rainbow": 1,
    "single-color-breath": 2,
    "fixed-color": 3,
    "neon": 4,
    "rainbow-breath": 5,
    "fixed-rainbow": 6,
}
EFFECT_NAMES = {
    1: "Rainbow",
    2: "Single Color Breath",
    3: "Fixed Color",
    4: "Neon",
    5: "Rainbow Breath",
    6: "Fixed Rainbow",
}
SWITCHES = {
    "motion-sync": ADDR_MOTION_SYNC,
    "angle-snap": ADDR_ANGLE_SNAP,
    "ripple": ADDR_RIPPLE,
    "performance": ADDR_PERFORMANCE,
}


class HelperError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


# ---- Finding the dongle ------------------------------------------------------

def usage_pages(descriptor):
    """Return the usage pages declared in a HID report descriptor."""
    pages, i = set(), 0
    while i < len(descriptor):
        prefix = descriptor[i]
        if prefix == 0xFE:  # long item
            i += 3 + (descriptor[i + 1] if i + 1 < len(descriptor) else 0)
            continue
        size = (0, 1, 2, 4)[prefix & 0x03]
        if prefix & 0xFC == 0x04:
            pages.add(int.from_bytes(descriptor[i + 1:i + 1 + size], "little"))
        i += 1 + size
    return pages


def find_device():
    base = "/sys/class/hidraw"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        names = []
    for name in names:
        dev = os.path.join(base, name, "device")
        try:
            with open(os.path.join(dev, "uevent")) as f:
                hid_id = next((l.split("=", 1)[1].strip() for l in f if l.startswith("HID_ID=")), "")
            with open(os.path.join(dev, "report_descriptor"), "rb") as f:
                descriptor = f.read()
        except OSError:
            continue
        parts = hid_id.split(":")
        if len(parts) != 3:
            continue
        vendor, product = int(parts[1], 16), int(parts[2], 16)
        if vendor == VENDOR_ID and product in PRODUCT_IDS and SETTINGS_USAGE_PAGE in usage_pages(descriptor):
            return "/dev/" + name
    raise HelperError(2, "Gravastar dongle not found")


# ---- Talking to it -----------------------------------------------------------

def packet(command, address=0, data=b"", length=None):
    body = bytearray(PACKET_LEN)
    body[0] = command
    body[2] = (address >> 8) & 0xFF
    body[3] = address & 0xFF
    body[4] = len(data) if length is None else length
    body[5:5 + len(data)] = data
    body[15] = (0x55 - (REPORT_ID + sum(body[:15]))) & 0xFF
    return bytes([REPORT_ID]) + bytes(body)


def valid_reply(data):
    return (len(data) >= PACKET_LEN + 1 and data[0] == REPORT_ID
            and (REPORT_ID + sum(data[1:PACKET_LEN + 1])) & 0xFF == 0x55)


class Mouse:
    def __init__(self, path):
        self.path = path
        try:
            self.fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError:
            raise HelperError(2, f"No permission to open {path}. Install the udev rule from the README.")

    def close(self):
        os.close(self.fd)

    def drain(self):
        while select.select([self.fd], [], [], 0)[0]:
            try:
                os.read(self.fd, 64)
            except BlockingIOError:
                break

    def transact(self, command, address=None, data=b"", length=None):
        """Send one request and return the 16-byte reply, or None."""
        raw = packet(command, address or 0, data, length)
        for _ in range(RETRIES):
            self.drain()
            os.write(self.fd, raw)
            deadline = time.monotonic() + REPLY_TIMEOUT
            while True:
                left = deadline - time.monotonic()
                if left <= 0 or not select.select([self.fd], [], [], left)[0]:
                    break
                try:
                    reply = os.read(self.fd, 64)
                except BlockingIOError:
                    continue
                if not valid_reply(reply) or reply[1] != command:
                    continue  # another program's reply, or noise
                body = reply[1:PACKET_LEN + 1]
                if address is not None and (body[2] << 8 | body[3]) != address:
                    continue
                return body
            time.sleep(0.2)
        return None

    def awake(self):
        reply = self.transact(CMD_ONLINE)
        return reply is not None and reply[5] == 1

    def require_awake(self):
        if not self.awake():
            raise HelperError(3, "Mouse is asleep. Move it and try again.")

    def read(self, address, length):
        out = bytearray()
        while length > 0:
            n = min(length, MAX_CHUNK)
            reply = self.transact(CMD_READ, address, length=n)
            if reply is None or reply[1] != 0 or reply[4] != n:
                raise HelperError(3, f"No answer reading 0x{address:02x}. Move the mouse and try again.")
            out += reply[5:5 + n]
            address += n
            length -= n
        return bytes(out)

    def write(self, address, data):
        reply = self.transact(CMD_WRITE, address, bytes(data))
        if reply is None or reply[1] != 0:
            raise HelperError(4, f"The mouse did not accept the write at 0x{address:02x}")
        if self.read(address, len(data)) != bytes(data):
            raise HelperError(4, f"The mouse did not keep the value written at 0x{address:02x}")

    def write_scalar(self, address, value):
        self.write(address, [value & 0xFF, (0x55 - value) & 0xFF])


# ---- Decoding ----------------------------------------------------------------

def scalar(block, address):
    if address + 1 >= len(block):
        return None
    value, check = block[address], block[address + 1]
    return value if (value + check) & 0xFF == 0x55 else None


def decode_dpi(entry):
    low, dup, flags, check = entry
    if low != dup or (low + dup + flags + check) & 0xFF != 0x55:
        return None
    return ((((flags >> 2) & 0x03) << 8) + low + 1) * 50


def encode_dpi(dpi):
    code = dpi // 50 - 1
    low, high = code & 0xFF, (code >> 8) & 0x03
    flags = (high << 2) | (high << 6)
    return [low, low, flags, (0x55 - low - low - flags) & 0xFF]


def on_off(value):
    return None if value is None else value != 0


def read_settings(mouse):
    block = mouse.read(0, 0xBD)
    stage_count = scalar(block, ADDR_STAGE_COUNT) or 1
    stage_count = max(1, min(stage_count, 8))
    active = scalar(block, ADDR_ACTIVE_STAGE)
    stages = [decode_dpi(block[ADDR_DPI_STAGES + i * 4:ADDR_DPI_STAGES + i * 4 + 4])
              for i in range(stage_count)]
    colors = []
    for i in range(stage_count):
        r, g, b, check = block[ADDR_DPI_COLORS + i * 4:ADDR_DPI_COLORS + i * 4 + 4]
        colors.append("#{:02x}{:02x}{:02x}".format(r, g, b) if (r + g + b + check) & 0xFF == 0x55 else None)
    light = block[ADDR_LIGHTING:ADDR_LIGHTING + LIGHTING_LEN]
    light_ok = sum(light) & 0xFF == 0x55
    lights_on = scalar(block, ADDR_LIGHTS_ON)
    effect = light[0] if light_ok else None
    lod = scalar(block, ADDR_LOD)
    sleep = scalar(block, ADDR_SLEEP)
    return {
        "pollingHz": POLLING_HZ.get(scalar(block, ADDR_POLLING)),
        "dpiStages": stages,
        "dpiColors": colors,
        "activeStage": None if active is None else active + 1,
        "dpi": stages[active] if active is not None and active < len(stages) else None,
        "lod": LOD_NAMES.get(lod),
        "lodRaw": lod,
        "keyResponseMs": scalar(block, ADDR_DEBOUNCE),
        "motionSync": on_off(scalar(block, ADDR_MOTION_SYNC)),
        "angleSnap": on_off(scalar(block, ADDR_ANGLE_SNAP)),
        "ripple": on_off(scalar(block, ADDR_RIPPLE)),
        "performance": on_off(scalar(block, ADDR_PERFORMANCE)),
        "performanceTimer": SLEEP_NAMES.get(scalar(block, ADDR_PERFORMANCE_TIMER)),
        "sensorMode": SENSOR_MODE_NAMES.get(scalar(block, ADDR_SENSOR_MODE)),
        "sleep": SLEEP_NAMES.get(sleep),
        "sleepRaw": sleep,
        "lighting": {
            "on": on_off(lights_on),
            "effect": "Off" if lights_on == 0 else EFFECT_NAMES.get(effect),
            "lastEffect": EFFECT_NAMES.get(effect),
            "color": "#{:02x}{:02x}{:02x}".format(*light[1:4]) if light_ok else None,
            "speed": light[4] + 1 if light_ok else None,
            "brightness": light[5] + 1 if light_ok else None,
            "offWhenMoving": on_off(scalar(block, ADDR_OFF_WHEN_MOVING)),
        },
    }


CACHED_KEYS = ("battery", "charging", "batteryMv", "firmware", "receiverFirmware", "profile", "settings")


def cache_path():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "omagravastar", "last-status.json")


def save_cache(status):
    path = cache_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w") as f:
            json.dump({k: status[k] for k in CACHED_KEYS if k in status}, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def load_cache():
    try:
        with open(cache_path()) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def read_status(mouse):
    status = {"connected": True, "device": mouse.path, "awake": mouse.awake()}
    if not status["awake"]:
        # Asleep: answer with the last values read while it was awake.
        cached = load_cache()
        if cached:
            status.update({k: cached[k] for k in CACHED_KEYS if k in cached})
            status["stale"] = True
        return status
    battery = mouse.transact(CMD_BATTERY)
    if battery is not None and battery[1] == 0 and battery[5] <= 100:
        status["battery"] = battery[5]
        status["charging"] = battery[6] == 1
        millivolts = battery[7] << 8 | battery[8]
        status["batteryMv"] = millivolts or None
    firmware = mouse.transact(CMD_FIRMWARE)
    if firmware is not None and firmware[1] == 0:
        status["firmware"] = f"v{firmware[5]}.{firmware[6]:02x}"
    dongle = mouse.transact(CMD_DONGLE_FIRMWARE)
    if dongle is not None:
        # The web driver shows v1.0 for a reply of 01 in the status byte.
        status["receiverFirmware"] = f"v{dongle[1]}.{dongle[2]}"
    profile = mouse.transact(CMD_PROFILE)
    if profile is not None and profile[1] == 0:
        status["profile"] = profile[5] + 1
    settings = read_settings(mouse)
    settings["longDistance"] = read_long_distance(mouse)
    status["settings"] = settings
    save_cache(status)
    return status


def read_long_distance(mouse):
    reply = mouse.transact(CMD_GET_LONG_DISTANCE)
    if reply is None or reply[1] != 0:
        return None
    return reply[5] == 1


def set_long_distance(mouse, value):
    data = bytes([value]) + bytes(MAX_CHUNK - 1)
    reply = mouse.transact(CMD_SET_LONG_DISTANCE, data=data)
    if reply is None or reply[1] != 0:
        raise HelperError(4, "The mouse did not accept the long distance mode change")
    if read_long_distance(mouse) != bool(value):
        raise HelperError(4, "The mouse did not keep the long distance mode change")


# ---- Commands ----------------------------------------------------------------

def parse_int(text, low, high, label):
    try:
        value = int(text)
    except ValueError:
        raise HelperError(1, f"{label} must be a whole number")
    if not low <= value <= high:
        raise HelperError(1, f"{label} must be {low}-{high}")
    return value


def parse_switch(text):
    if text not in ("on", "off"):
        raise HelperError(1, "use on or off")
    return 1 if text == "on" else 0


def update_lighting(mouse, change):
    record = bytearray(mouse.read(ADDR_LIGHTING, LIGHTING_LEN))
    if sum(record) & 0xFF != 0x55:
        raise HelperError(4, "The lighting settings on the mouse look damaged; not writing")
    change(record)
    record[6] = (0x55 - sum(record[:6])) & 0xFF
    mouse.write(ADDR_LIGHTING, record)


def run_set(mouse, args):
    if len(args) < 2:
        raise HelperError(1, "set needs a setting and a value")
    what, rest = args[0], args[1:]
    if what == "dpi-stage":
        if len(rest) != 2:
            raise HelperError(1, "usage: set dpi-stage <stage> <dpi>")
        count = scalar(mouse.read(ADDR_STAGE_COUNT, 2), 0) or 1
        stage = parse_int(rest[0], 1, count, "stage")
        dpi = parse_int(rest[1], 50, 26000, "DPI")
        if dpi % 50:
            raise HelperError(1, "DPI must be a multiple of 50")
        mouse.write(ADDR_DPI_STAGES + (stage - 1) * 4, encode_dpi(dpi))
    elif what == "stage-count":
        count = parse_int(rest[0], 1, 8, "stage count")
        active = scalar(mouse.read(ADDR_ACTIVE_STAGE, 2), 0) or 0
        if active > count - 1:
            mouse.write_scalar(ADDR_ACTIVE_STAGE, count - 1)
        mouse.write_scalar(ADDR_STAGE_COUNT, count)
    elif what == "active-stage":
        count = scalar(mouse.read(ADDR_STAGE_COUNT, 2), 0) or 1
        mouse.write_scalar(ADDR_ACTIVE_STAGE, parse_int(rest[0], 1, count, "stage") - 1)
    elif what == "polling":
        hz = parse_int(rest[0], 125, 8000, "polling rate")
        if hz not in POLLING_RAW:
            raise HelperError(1, "polling rate must be 125, 250, 500, 1000, 2000, 4000 or 8000")
        mouse.write_scalar(ADDR_POLLING, POLLING_RAW[hz])
    elif what == "key-response":
        mouse.write_scalar(ADDR_DEBOUNCE, parse_int(rest[0], 0, 30, "key response time"))
    elif what in SWITCHES:
        mouse.write_scalar(SWITCHES[what], parse_switch(rest[0]))
    elif what == "lod":
        if rest[0] not in LOD_CHOICES:
            raise HelperError(1, "lod must be " + ", ".join(LOD_CHOICES))
        mouse.write_scalar(ADDR_LOD, LOD_CHOICES[rest[0]])
    elif what in ("sleep", "performance-timer"):
        if rest[0] not in SLEEP_CHOICES:
            raise HelperError(1, f"{what} must be " + ", ".join(SLEEP_CHOICES))
        address = ADDR_SLEEP if what == "sleep" else ADDR_PERFORMANCE_TIMER
        mouse.write_scalar(address, SLEEP_CHOICES[rest[0]])
    elif what == "sensor-mode":
        if rest[0] not in SENSOR_MODES:
            raise HelperError(1, "sensor-mode must be lp or hp (Corded is automatic above 1000 Hz)")
        mouse.write_scalar(ADDR_SENSOR_MODE, SENSOR_MODES[rest[0]])
    elif what == "long-distance":
        set_long_distance(mouse, parse_switch(rest[0]))
    else:
        raise HelperError(1, f"unknown setting: {what}")


def run_light(mouse, args):
    if len(args) != 2:
        raise HelperError(1, "light needs a setting and a value")
    what, value = args
    if what == "effect":
        if value == "off":
            mouse.write_scalar(ADDR_LIGHTS_ON, 0)
            return
        if value not in EFFECTS:
            raise HelperError(1, "effect must be off, " + ", ".join(EFFECTS))
        def set_effect(record):
            record[0] = EFFECTS[value]
        update_lighting(mouse, set_effect)
        mouse.write_scalar(ADDR_LIGHTS_ON, 1)
    elif what == "color":
        text = value.lstrip("#")
        try:
            rgb = bytes.fromhex(text)
        except ValueError:
            rgb = b""
        if len(rgb) != 3:
            raise HelperError(1, "color must look like #ff00ff")
        def set_color(record):
            record[1:4] = rgb
        update_lighting(mouse, set_color)
    elif what in ("brightness", "speed"):
        level = parse_int(value, 1, 10, what)
        index = 5 if what == "brightness" else 4
        def set_level(record):
            record[index] = level - 1
        update_lighting(mouse, set_level)
    elif what == "off-when-moving":
        mouse.write_scalar(ADDR_OFF_WHEN_MOVING, parse_switch(value))
    else:
        raise HelperError(1, f"unknown light setting: {what}")


def with_lock():
    """Keep the bar's polling and a settings change from talking over each other."""
    folder = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "omagravastar")
    os.makedirs(folder, exist_ok=True)
    handle = open(os.path.join(folder, "device.lock"), "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    lock = with_lock()
    try:
        try:
            path = find_device()
        except HelperError as error:
            if argv[0] == "status":
                print(json.dumps({"connected": False, "awake": False, "error": str(error)}))
            raise
        mouse = Mouse(path)
        try:
            if argv[0] == "status":
                result = read_status(mouse)
            elif argv[0] in ("set", "light"):
                mouse.require_awake()
                (run_set if argv[0] == "set" else run_light)(mouse, argv[1:])
                result = read_status(mouse)
                result["ok"] = True
            else:
                raise HelperError(1, f"unknown command: {argv[0]}")
        finally:
            mouse.close()
        print(json.dumps(result))
        return 0
    finally:
        lock.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except HelperError as error:
        if not (error.code == 2 and sys.argv[1:2] == ["status"]):
            print(json.dumps({"ok": False, "error": str(error)}))
        sys.exit(error.code)
