#!/usr/bin/env python3
"""Talk to a Gravastar Mercury X Pro through its 2.4G dongle.

The plugin calls this helper and reads its JSON output. It uses the CompX
settings channel (usage page 0xff02, report ID 8, 16-byte reports) through
/dev/hidraw, so it needs no extra packages and no root once the udev rule
from the README is installed.

Usage:
  omagravastarctl status
  omagravastarctl set dpi-stage <stage 1-8> <dpi>
  omagravastarctl set active-stage <stage 1-8>
  omagravastarctl set stage-count <1-8>
  omagravastarctl set polling <125|250|500|1000|2000|4000|8000>
  omagravastarctl set key-response <ms 0-15>
  omagravastarctl set lod <0.7mm|1mm|2mm>
  omagravastarctl set motion-sync|angle-snap|ripple|performance <on|off>
  omagravastarctl set sleep <10sec|30sec|1min|2min|3min|5min|10min|15min>
  omagravastarctl set performance-timer <10sec|30sec|1min|2min|3min|5min|10min|15min>
  omagravastarctl set long-distance <on|off>
  omagravastarctl set profile <1-4>          (each profile holds a full set of settings)
  omagravastarctl set sensor-mode <lp|hp>   (Corded is automatic above 1000 Hz)
  omagravastarctl button <1-6> <action>     (see `omagravastarctl actions`)
  omagravastarctl actions
  omagravastarctl macro <1-6> <macro.json | '{json}'>  (write a macro to a button; see MACROS)
  omagravastarctl export <file.bin>         (current profile, Gravastar web driver format)
  omagravastarctl import <file.bin>         (into the current profile; backs it up first)
  omagravastarctl light effect <off|rainbow|single-color-breath|fixed-color|neon|rainbow-breath|fixed-rainbow>
  omagravastarctl light color <#rrggbb>
  omagravastarctl light brightness <1-10>
  omagravastarctl light speed <1-10>
  omagravastarctl light off-when-moving <on|off>

MACROS: macro.json is {"name": "...", "method": M, "events": [{"down": true,
"type": 1, "code": 4, "delay": 50}, ...]}. type 1 = keyboard (USB HID usage
code), type 4 = mouse button (1 left, 2 right, 4 middle, 8 back, 16 forward).
method: 1-252 = repeat that many times, 254 = until this button is released,
255 = until any button is pressed, 253 = until this button is pressed again.

Every command prints one JSON object. Exit status: 0 ok, 1 bad arguments,
2 dongle not found, 3 mouse asleep, 4 the mouse rejected or lost a write.
"""

import fcntl
import json
import os
import select
import sys
import time

VENDOR_ID = 0x3554
PRODUCT_IDS = {0xF54B}
REPORT_ID = 0x08
SETTINGS_USAGE_PAGE = 0xFF02
PACKET_LEN = 16
MAX_CHUNK = 10
REPLY_TIMEOUT = 0.7
RETRIES = 4

CMD_ONLINE = 0x03
CMD_BATTERY = 0x04
CMD_WRITE = 0x07
CMD_READ = 0x08
CMD_PROFILE = 0x0E
CMD_SET_PROFILE = 0x0F
PROFILE_COUNT = 4
CMD_FIRMWARE = 0x12
CMD_SET_LONG_DISTANCE = 0x16
CMD_GET_LONG_DISTANCE = 0x17
